terraform {
  experiments = [module_variable_optional_attrs]
}

# Provider configuration is generated by Terragrunt's root.hcl
# via `generate "provider" { ... }` — this module does not declare a provider block

# Pull the Docker image
resource "docker_image" "app" {
  name = var.image_name

  pull_triggers = [var.image_name]
}

# Create Docker network (if using bridge mode)
resource "docker_network" "app" {
  count  = var.network_mode == "bridge" ? 1 : 0
  name   = var.network_name
  driver = var.network_driver

  ipam_config {
    subnet = var.network_cidr != "" ? var.network_cidr : null
  }

  labels = {
    for key, value in var.tags :
    key => value
  }
}

# Prepare port mappings
locals {
  port_bindings = {
    for binding in var.port_mappings :
    "${binding.internal}/${lower(binding.protocol)}" => [
      {
        host_ip   = "0.0.0.0"
        host_port = tostring(binding.external)
      }
    ]
  }
}

# Create the container
resource "docker_container" "app" {
  name  = var.container_name
  image = docker_image.app.id

  # Networking
  dynamic "networks_advanced" {
    for_each = var.network_mode == "bridge" ? [1] : []
    content {
      name = docker_network.app[0].name
    }
  }

  network_mode = var.network_mode != "bridge" ? var.network_mode : null

  # Port mappings
  dynamic "ports" {
    for_each = var.port_mappings
    content {
      internal = ports.value.internal
      external = ports.value.external
      protocol = lower(ports.value.protocol)
    }
  }

  # Environment variables
  env = [
    for key, value in var.environment_vars :
    "${key}=${value}"
  ]

  # Volume mounts
  dynamic "volumes" {
    for_each = var.volume_mounts
    content {
      host_path      = volumes.value.host_path
      container_path = volumes.value.container_path
      read_only      = volumes.value.read_only
    }
  }

  # Resource limits
  memory         = var.container_memory_mb > 0 ? var.container_memory_mb : null
  cpu_shares     = var.container_cpu_shares > 0 ? var.container_cpu_shares : null
  restart_policy = var.restart_policy
  privileged     = var.privileged

  # Labels
  labels = {
    for key, value in var.tags :
    key => value
  }

  # Ensure clean startup/shutdown
  stdin_open = false
  tty        = false

  lifecycle {
    ignore_changes = [image]
  }
}
