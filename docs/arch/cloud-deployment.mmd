---
config:
  architecture:
    randomize: false
    seed: 7
    nodeSeparation: 30
    idealEdgeLengthMultiplier: 0.6
---
architecture-beta

group external(internet)[UNTRUSTED EXTERNAL]

service internet(internet)[Internet] in external
service users(server)[Internet Users] in external
service admin(server)[Platform Admin] in external
service onprem(server)[Future On Prem] in external
service othercloud(cloud)[Future Cloud] in external

%% ---- OCI tenancy / compartment / region -------------------------------
group tenancy(cloud)[OCI TENANCY]

service iam(server)[IAM · Policies · Dynamic Groups] in tenancy
service audit(server)[Audit] in tenancy
service tags(server)[Defined Tags] in tenancy

group compartment(cloud)[PLATFORM COMPARTMENT] in tenancy

service publicdns(server)[OCI Public DNS] in compartment
service ociServices(disk)[OCI Services: Bucket · KMS · Logging · Monitoring] in compartment

group region(cloud)[OCI MADRID REGION] in compartment

%% ---- VCN security perimeter -------------------------------------------
group vcn(cloud)[VCN 10.10.0.0/16] in region

service gateways(internet)[Gateways: IGW · NAT · SGW · DRG] in vcn
service routes(server)[Route Tables: Edge · Mgmt · Workload · Data] in vcn
service dns(server)[VCN DNS + DHCP] in vcn

%% ---- Edge zone ---------------------------------------------------------
group edge(cloud)[EDGE 10.10.10.0/24] in vcn

service ingressPub(internet)[Ingress Public IP] in edge
service ingress(server)[Application Ingress] in edge
service ingressSec(server)[Edge SL + Ingress NSG] in edge

service zitiPub(internet)[Ziti Public IP] in edge
service zitiEdge(server)[OpenZiti Edge Router] in edge
service zitiSec(server)[Edge SL + Ziti NSG] in edge

%% ---- Management zone ---------------------------------------------------
group management(cloud)[MGMT 10.10.20.0/24] in vcn

service cpNode(server)[Talos Control Plane] in management
service kubeAPI(server)[Kubernetes API] in management
service etcd(database)[etcd] in management
service cpBoot(disk)[CP Boot Volume] in management
service zitiPriv(server)[Ziti Private Router] in management
service mgmtSec(server)[Mgmt SL + Control NSG] in management

%% ---- Workload zone (2 workers collapsed) -------------------------------
group workload(cloud)[WORKLOAD 10.10.30.0/24] in vcn

service workers(server)[Talos Workers ×2] in workload
service workerBoot(disk)[Worker Boot Volumes ×2] in workload
service workerSec(server)[Workload SL + Worker NSG] in workload

%% ---- Data zone (2 volumes collapsed) -----------------------------------
group data(cloud)[DATA 10.10.40.0/24] in vcn

service storageVNICs(server)[Storage VNICs ×2] in data
service blockVolumes(disk)[Block Volumes ×2] in data
service backupAgent(server)[Backup Endpoint] in data
service dataSec(server)[Data SL + Storage NSG] in data

%% ---- Shared junctions ---------------------------------------------------
junction egressJ in vcn
junction serviceJ in vcn
junction hybridJ in vcn

%% =====================================================================
%% RED — Internet user ingress
%% =====================================================================
users:R --> L:publicdns
publicdns{group}:R --> L:ingressPub{group}
internet{group}:R --> L:gateways{group}
gateways:R --> L:routes
routes:R --> L:ingressPub
ingressPub:B --> T:ingress
ingressSec:R --> L:ingress
ingress{group}:R --> L:workers{group}

%% =====================================================================
%% PURPLE — Administrator access + control plane
%% =====================================================================
admin:R --> L:zitiPub
zitiPub:B --> T:zitiEdge
zitiSec:R --> L:zitiEdge
zitiEdge{group}:R --> L:zitiPriv{group}
zitiPriv:R --> L:kubeAPI

cpNode:R --> L:kubeAPI
cpNode:B --> T:etcd
cpNode:L --> R:cpBoot
mgmtSec:R --> L:kubeAPI
kubeAPI{group}:R --> L:workers{group}
workerSec:R --> L:workers
workers:B --> T:workerBoot

%% =====================================================================
%% GREEN — Private Internet egress (via NAT gateway)
%% =====================================================================
cpNode{group}:R --> L:egressJ{group}
workers{group}:R --> L:egressJ{group}
egressJ:R --> L:gateways
gateways{group}:T --> B:internet{group}

%% =====================================================================
%% BLUE — OCI services + storage/backup (via Service Gateway)
%% =====================================================================
cpNode{group}:B --> T:serviceJ{group}
workers{group}:B --> T:serviceJ{group}
serviceJ:R --> L:gateways
gateways{group}:B --> T:ociServices{group}

dataSec:R --> L:storageVNICs
storageVNICs:R --> L:blockVolumes
blockVolumes:R --> L:backupAgent
backupAgent{group}:R --> L:gateways{group}

%% =====================================================================
%% ORANGE — Hybrid connectivity (via DRG)
%% =====================================================================
management{group}:L --> R:hybridJ{group}
workload{group}:L --> R:hybridJ{group}
hybridJ:L --> R:gateways
gateways{group}:L --> R:onprem{group}
gateways{group}:L --> R:othercloud{group}

%% =====================================================================
%% Governance
%% =====================================================================
iam{group}:R --> L:ociServices{group}
audit{group}:R --> L:ociServices{group}
tags{group}:R --> L:region{group}
